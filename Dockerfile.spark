FROM apache/spark:3.5.1

# ============================================================
# ROOT USER
# ============================================================

USER root

# ============================================================
# SYSTEM DEPENDENCIES
# ============================================================

RUN apt-get update && \
    apt-get install -y \
        python3-pip \
        curl \
        procps \
    && \
    pip3 install --no-cache-dir \
        numpy \
        pandas \
        pyarrow \
        scipy \
        scikit-learn \
        kafka-python \
        psycopg2-binary \
    && \
    rm -rf /var/lib/apt/lists/*

# ============================================================
# POSTGRESQL JDBC DRIVER
# ============================================================

RUN curl -fL \
    --retry 10 \
    --retry-delay 5 \
    --retry-max-time 300 \
    https://jdbc.postgresql.org/download/postgresql-42.7.7.jar \
    -o /opt/spark/jars/postgresql-42.7.7.jar

# ============================================================
# SPARK DIRECTORIES
# ============================================================

RUN mkdir -p /home/spark/.ivy2/cache && \
    mkdir -p /home/spark/.ivy2/jars && \
    chown -R spark:spark /home/spark && \
    chown spark:spark /opt/spark/jars/postgresql-42.7.7.jar

# ============================================================
# ENVIRONMENT
# ============================================================

ENV SPARK_HOME=/opt/spark

ENV PATH=/opt/spark/bin:/opt/spark/sbin:/usr/local/bin:/usr/bin:/bin

# ============================================================
# SPARK USER
# ============================================================

USER spark
